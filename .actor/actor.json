{
    "actorSpecification": 1,
    "name": "italian-company-data-scraper",
    "title": "Italian Company Data Scraper — business registry dataset by category",
    "description": "Extract structured Italian company data by validated business categories from aziende.it. Fast listing mode returns company name, revenue range, ATECO code and location. Optional detail enrichment adds VAT number, address, postal code and employee range when available.",
    "version": "11.4",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": {
        "timeoutSecs": 300,
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Italian Companies Dataset",
            "views": {
                "overview": {
                    "title": "Companies",
                    "transformation": {
                        "fields": [
                            "ragioneSociale",
                            "categoryKey",
                            "fatturato",
                            "fatturatoMinEur",
                            "fatturatoMaxEur",
                            "ateco",
                            "provincia",
                            "citta",
                            "categoria",
                            "detailUrl",
                            "partitaIva",
                            "indirizzo",
                            "cap",
                            "dipendenti",
                            "codiceFiscale",
                            "rea",
                            "telefono",
                            "email",
                            "pec",
                            "sitoWeb",
                            "formaGiuridica",
                            "statoAttivita",
                            "dataCostituzione",
                            "sourceCategoryUrl",
                            "detailScraped"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "ragioneSociale": { "label": "Company name", "format": "text" },
                            "categoryKey": { "label": "Requested category", "format": "text" },
                            "fatturato": { "label": "Revenue range", "format": "text" },
                            "fatturatoMinEur": { "label": "Revenue min EUR", "format": "number" },
                            "fatturatoMaxEur": { "label": "Revenue max EUR", "format": "number" },
                            "ateco": { "label": "ATECO code", "format": "text" },
                            "provincia": { "label": "Province", "format": "text" },
                            "citta": { "label": "City", "format": "text" },
                            "categoria": { "label": "Source category label", "format": "text" },
                            "detailUrl": { "label": "Company detail page", "format": "link" },
                            "partitaIva": { "label": "VAT number", "format": "text" },
                            "indirizzo": { "label": "Address", "format": "text" },
                            "cap": { "label": "Postal code", "format": "text" },
                            "dipendenti": { "label": "Employees", "format": "text" },
                            "codiceFiscale": { "label": "Tax code", "format": "text" },
                            "rea": { "label": "REA", "format": "text" },
                            "telefono": { "label": "Phone", "format": "text" },
                            "email": { "label": "Email", "format": "text" },
                            "pec": { "label": "PEC", "format": "text" },
                            "sitoWeb": { "label": "Website", "format": "link" },
                            "formaGiuridica": { "label": "Legal form", "format": "text" },
                            "statoAttivita": { "label": "Activity status", "format": "text" },
                            "dataCostituzione": { "label": "Foundation date", "format": "text" },
                            "sourceCategoryUrl": { "label": "Source category URL", "format": "link" },
                            "detailScraped": { "label": "Details included", "format": "boolean" }
                        }
                    }
                }
            }
        }
    }
}
