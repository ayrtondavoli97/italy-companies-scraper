{
    "actorSpecification": 1,
    "name": "italy-companies-scraper",
    "title": "Italy Companies Scraper — Search by Region & Province",
    "description": "Extract Italian company data from registroimprese.it (official CCIAA registry) by geographic area. Input: region or province. Optional: ATECO code, legal form, company status.",
    "version": "2.0",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": { "timeoutSecs": 600, "memoryMbytes": 1024 },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Italian Companies",
            "views": {
                "overview": {
                    "title": "Companies",
                    "transformation": { "fields": ["ragioneSociale","cf","comune","provincia","indirizzo","ateco","formaGiuridica","stato","detailUrl"] },
                    "display": {
                        "component": "table",
                        "properties": {
                            "ragioneSociale": { "label": "Ragione Sociale", "format": "text" },
                            "cf":             { "label": "CF / P.IVA",      "format": "text" },
                            "comune":         { "label": "Comune",           "format": "text" },
                            "provincia":      { "label": "Provincia",        "format": "text" },
                            "indirizzo":      { "label": "Indirizzo",        "format": "text" },
                            "ateco":          { "label": "ATECO",            "format": "text" },
                            "formaGiuridica": { "label": "Forma Giuridica",  "format": "text" },
                            "stato":          { "label": "Stato",            "format": "text" },
                            "detailUrl":      { "label": "Scheda",           "format": "link" }
                        }
                    }
                }
            }
        }
    }
}
