{
    "actorSpecification": 1,
    "name": "italy-companies-scraper",
    "title": "Italy Companies Scraper — Italian business registry dataset",
    "description": "Extract Italian company registry-style data by business category from aziende.it. The default mode is a fast listing dataset. Optional full details enrichment adds VAT number, address, postal code and employee range when available.",
    "version": "11.2",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": {
        "timeoutSecs": 300,
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Italian Companies Dataset",
            "views": {
                "overview": {
                    "title": "Companies",
                    "transformation": {
                        "fields": [
                            "ragioneSociale",
                            "fatturato",
                            "fatturatoMinEur",
                            "fatturatoMaxEur",
                            "ateco",
                            "provincia",
                            "citta",
                            "categoria",
                            "detailUrl",
                            "partitaIva",
                            "indirizzo",
                            "cap",
                            "dipendenti",
                            "codiceFiscale",
                            "rea",
                            "telefono",
                            "email",
                            "pec",
                            "sitoWeb",
                            "formaGiuridica",
                            "statoAttivita",
                            "dataCostituzione",
                            "detailScraped"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "ragioneSociale": { "label": "Company name", "format": "text" },
                            "fatturato": { "label": "Revenue range", "format": "text" },
                            "fatturatoMinEur": { "label": "Revenue min EUR", "format": "number" },
                            "fatturatoMaxEur": { "label": "Revenue max EUR", "format": "number" },
                            "ateco": { "label": "ATECO code", "format": "text" },
                            "provincia": { "label": "Province", "format": "text" },
                            "citta": { "label": "City", "format": "text" },
                            "categoria": { "label": "Source category", "format": "text" },
                            "detailUrl": { "label": "Source detail page", "format": "link" },
                            "partitaIva": { "label": "VAT number", "format": "text" },
                            "indirizzo": { "label": "Address", "format": "text" },
                            "cap": { "label": "Postal code", "format": "text" },
                            "dipendenti": { "label": "Employees", "format": "text" },
                            "codiceFiscale": { "label": "Tax code", "format": "text" },
                            "rea": { "label": "REA", "format": "text" },
                            "telefono": { "label": "Phone", "format": "text" },
                            "email": { "label": "Email", "format": "text" },
                            "pec": { "label": "PEC", "format": "text" },
                            "sitoWeb": { "label": "Website", "format": "link" },
                            "formaGiuridica": { "label": "Legal form", "format": "text" },
                            "statoAttivita": { "label": "Activity status", "format": "text" },
                            "dataCostituzione": { "label": "Foundation date", "format": "text" },
                            "detailScraped": { "label": "Details included", "format": "boolean" }
                        }
                    }
                }
            }
        }
    }
}
