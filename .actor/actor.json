{
    "actorSpecification": 1,
    "name": "aziende-it-scraper",
    "title": "Italy Companies Scraper — companies by simple category",
    "description": "Scrape Italian company listings from aziende.it using simple category names such as informatica, alimentare, tessile, edilizia and more. Optionally enriches results from company detail pages with VAT, tax code, REA, address, PEC, email, phone, website and other public fields when available.",
    "version": "10.0",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": {
        "timeoutSecs": 3600,
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Italian Companies",
            "views": {
                "overview": {
                    "title": "Companies",
                    "transformation": {
                        "fields": [
                            "ragioneSociale",
                            "partitaIva",
                            "codiceFiscale",
                            "ateco",
                            "fatturato",
                            "fatturatoMinEur",
                            "fatturatoMaxEur",
                            "provincia",
                            "citta",
                            "indirizzo",
                            "cap",
                            "telefono",
                            "email",
                            "pec",
                            "sitoWeb",
                            "formaGiuridica",
                            "statoAttivita",
                            "dipendenti",
                            "categoria",
                            "detailUrl"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "ragioneSociale": { "label": "Ragione Sociale", "format": "text" },
                            "partitaIva": { "label": "Partita IVA", "format": "text" },
                            "codiceFiscale": { "label": "Codice Fiscale", "format": "text" },
                            "ateco": { "label": "ATECO", "format": "text" },
                            "fatturato": { "label": "Fatturato", "format": "text" },
                            "fatturatoMinEur": { "label": "Fatturato min EUR", "format": "number" },
                            "fatturatoMaxEur": { "label": "Fatturato max EUR", "format": "number" },
                            "provincia": { "label": "Provincia", "format": "text" },
                            "citta": { "label": "Città", "format": "text" },
                            "indirizzo": { "label": "Indirizzo", "format": "text" },
                            "cap": { "label": "CAP", "format": "text" },
                            "telefono": { "label": "Telefono", "format": "text" },
                            "email": { "label": "Email", "format": "text" },
                            "pec": { "label": "PEC", "format": "text" },
                            "sitoWeb": { "label": "Sito web", "format": "link" },
                            "formaGiuridica": { "label": "Forma giuridica", "format": "text" },
                            "statoAttivita": { "label": "Stato attività", "format": "text" },
                            "dipendenti": { "label": "Dipendenti", "format": "text" },
                            "categoria": { "label": "Categoria", "format": "text" },
                            "detailUrl": { "label": "Scheda", "format": "link" }
                        }
                    }
                }
            }
        }
    }
}
