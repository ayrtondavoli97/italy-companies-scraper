{
    "actorSpecification": 1,
    "name": "aziende-it-scraper",
    "title": "Aziende.it Scraper — Italian companies by ATECO category",
    "description": "Scrape Italian company listings from aziende.it by ATECO category: name, revenue band, ATECO code, province, city, detail URL. Fast HTTP scraper, no browser.",
    "version": "9.0",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": {
        "timeoutSecs": 600,
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Italian Companies",
            "views": {
                "overview": {
                    "title": "Companies",
                    "transformation": {
                        "fields": [
                            "ragioneSociale",
                            "ateco",
                            "fatturato",
                            "provincia",
                            "citta",
                            "categoria",
                            "detailUrl"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "ragioneSociale": {
                                "label": "Ragione Sociale",
                                "format": "text"
                            },
                            "ateco": {
                                "label": "ATECO",
                                "format": "text"
                            },
                            "fatturato": {
                                "label": "Fatturato",
                                "format": "text"
                            },
                            "provincia": {
                                "label": "Provincia",
                                "format": "text"
                            },
                            "citta": {
                                "label": "Città",
                                "format": "text"
                            },
                            "categoria": {
                                "label": "Categoria",
                                "format": "text"
                            },
                            "detailUrl": {
                                "label": "Scheda",
                                "format": "link"
                            }
                        }
                    }
                }
            }
        }
    }
}