{
    "actorSpecification": 1,
    "name": "italy-companies-scraper",
    "title": "Italy Companies Scraper — Search by Region & Province",
    "description": "Extract Italian company listings from registroimprese.it (ricerca libera, official CCIAA registry) by free-text keyword/category, segmented by region/province. Listing-only base.",
    "version": "3.0",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "input": "./input_schema.json",
    "defaultRunOptions": {
        "timeoutSecs": 600,
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Italian Companies",
            "views": {
                "overview": {
                    "title": "Companies",
                    "transformation": {
                        "fields": [
                            "ragioneSociale",
                            "comune",
                            "provincia",
                            "formaGiuridica",
                            "descrizione",
                            "stato",
                            "detailUrl"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "ragioneSociale": {
                                "label": "Ragione Sociale",
                                "format": "text"
                            },
                            "comune": {
                                "label": "Comune",
                                "format": "text"
                            },
                            "provincia": {
                                "label": "Provincia",
                                "format": "text"
                            },
                            "formaGiuridica": {
                                "label": "Forma Giuridica",
                                "format": "text"
                            },
                            "descrizione": {
                                "label": "Attività",
                                "format": "text"
                            },
                            "stato": {
                                "label": "Stato",
                                "format": "text"
                            },
                            "detailUrl": {
                                "label": "Scheda",
                                "format": "link"
                            }
                        }
                    }
                }
            }
        }
    }
}